{
  "name": "browserslist-update-action",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "A GitHub Action to run `update-browserslist-db@latest` on a repository and propose a pull request to merge updates",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rollup --config rollup.config.js",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check . && eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "all": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c2corg/browserslist-update-action.git"
  },
  "keywords": [
    "actions",
    "browserslist",
    "caniuse"
  ],
  "author": "Camptocamp Association",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/c2corg/browserslist-update-action/issues"
  },
  "homepage": "https://github.com/c2corg/browserslist-update-action#readme",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/github": "9.1.1",
    "package-manager-detector": "1.9.0",
    "strip-ansi": "7.2.0"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown --list-different",
    "*.ts": "eslint --fix --report-unused-disable-directives"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.1",
    "@tsconfig/node24": "24.0.6",
    "@tsconfig/strictest": "2.0.9",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "rollup": "4.68.8",
    "tslib": "2.9.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
